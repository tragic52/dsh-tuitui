{
  "name": "dsh-tuitui",
  "version": "0.1.0",
  "description": "把 360 推推（Tuitui）IM 机器人接入 DeepSeek Harness，由 Harness agent 收发消息，可在设置页启用/停止。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tragic52/dsh-tuitui.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tuitui",
    "im-bot",
    "360 推推",
    "chatbot"
  ],
  "bugs": {
    "url": "https://github.com/tragic52/dsh-tuitui/issues"
  },
  "author": "tragic52",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node plugin-src/host/build.mjs && node plugin-src/client/build.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@qihoo/tuitui-bot-sdk": "1.0.19",
    "esbuild": "0.25.9"
  }
}
